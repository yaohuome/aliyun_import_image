# 复制为 .env 并填入真实值

# ---- 必填 ----
ALIYUN_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
# 导入目标地域, 同时也是 OSS Bucket 的地域(两者必须一致)
ALIYUN_REGION_ID=cn-hongkong
# 中转用的 OSS Bucket 名(全局唯一)。不存在会自动创建, 导入完成后可自动删除文件。
# 留空则自动复用/创建 imgimport-<地域>-<随机后缀> 的唯一名, 避免手选的名字被占用。
OSS_BUCKET=

# ---- 可选 ----
# OSS 接入点, 留空则按地域自动推导为 https://oss-<region>.aliyuncs.com
OSS_ENDPOINT=
# 上传到 OSS 里的对象前缀(目录), 建议保留一层目录便于清理
IMAGE_OBJECT_PREFIX=images/

# 导入镜像的默认参数(命令行可覆盖)
# 启动模式: BIOS 或 UEFI, 必须与镜像实际引导方式一致
IMAGE_BOOT_MODE=BIOS
# 操作系统平台: 自建镜像一般用 "Customized Linux"; 也可填 Debian / CentOS / Ubuntu 等
IMAGE_PLATFORM=Customized Linux
# 架构: x86_64 / i386 / arm64
IMAGE_ARCHITECTURE=x86_64
# 云盘属性(系统盘大小, GiB): 决定后续 ECS 实例系统盘的最小值, 最小 1
IMAGE_DISK_SIZE=1
# 镜像格式: auto(自动识别) / RAW / QCOW2 / VHD
IMAGE_FORMAT=auto
